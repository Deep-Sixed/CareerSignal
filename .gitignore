# Local runtime and credentials; these rules do not replace privacy scanning.
/var/
/.env
/.env.*
!/.env.example
credentials.json
token.json
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.kdbx
*.pem
*.key
*.bundle

# Python/build tooling
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Local editor / operating system files
.DS_Store
Thumbs.db
.idea/
